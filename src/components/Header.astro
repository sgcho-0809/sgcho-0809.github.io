---
import { languages, localizePath, pages, toLang, useTranslations, type Lang } from '../i18n/ui';

const lang = toLang(Astro.currentLocale);
const t = useTranslations(lang);
const home = localizePath('/', lang);
const langOptions = (Object.keys(languages) as Lang[]).map((code) => ({
	code,
	name: languages[code],
	href: localizePath(Astro.url.pathname, code),
}));
const current = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;

const links = pages.map((page) => {
	const href = localizePath(`/${page}/`, lang);
	return { href, label: t(`nav.${page}`), active: current.startsWith(href) };
});
---

<header>
	<div class="container inner">
		<a class="logo" href={home}>{t('hero.name')}</a>
		<nav class="links">
			{
				links.map((link) => (
					<a href={link.href} aria-current={link.active ? 'page' : undefined}>
						{link.label}
					</a>
				))
			}
		</nav>
		<div class="tools">
			<button class="theme" type="button" aria-label={t('theme.toggle')} title={t('theme.toggle')}>
				<svg class="moon" viewBox="0 0 24 24" aria-hidden="true">
					<path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" />
				</svg>
				<svg class="sun" viewBox="0 0 24 24" aria-hidden="true">
					<path
						d="M12 16a4 4 0 1 0 0-8 4 4 0 0 0 0 8ZM12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
					/>
				</svg>
			</button>
			<details class="lang">
				<summary aria-label={t('lang.label')}>
					<svg viewBox="0 0 24 24" aria-hidden="true">
						<path d="M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18ZM3 12h18M12 3c2.5 2.5 3.8 5.5 3.8 9s-1.3 6.5-3.8 9c-2.5-2.5-3.8-5.5-3.8-9S9.5 5.5 12 3Z" />
					</svg>
					{languages[lang]}
				</summary>
				<ul>
					{
						langOptions.map((option) => (
							<li>
								<a
									href={option.href}
									hreflang={option.code}
									lang={option.code}
									aria-current={option.code === lang ? 'true' : undefined}
								>
									{option.name}
								</a>
							</li>
						))
					}
				</ul>
			</details>
		</div>
	</div>
</header>

<script is:inline>
	const langMenu = document.querySelector('header .lang');
	document.addEventListener('click', (event) => {
		if (langMenu?.open && !langMenu.contains(event.target)) langMenu.open = false;
	});
	document.addEventListener('keydown', (event) => {
		if (event.key === 'Escape' && langMenu?.open) {
			langMenu.open = false;
			langMenu.querySelector('summary')?.focus();
		}
	});

	document.querySelector('header .theme')?.addEventListener('click', () => {
		const root = document.documentElement;
		const dark = root.dataset.theme
			? root.dataset.theme === 'dark'
			: matchMedia('(prefers-color-scheme: dark)').matches;
		const next = dark ? 'light' : 'dark';
		root.dataset.theme = next;
		try {
			localStorage.setItem('theme', next);
		} catch {}
	});
</script>

<style>
	header {
		position: sticky;
		top: 0;
		z-index: 10;
		background: color-mix(in srgb, var(--color-bg) 88%, transparent);
		backdrop-filter: blur(8px);
		border-bottom: 1px solid var(--color-border);
		view-transition-name: site-header;
	}

	.inner {
		display: grid;
		grid-template-columns: auto 1fr auto;
		grid-template-areas: 'logo links lang';
		align-items: center;
		gap: 20px;
		height: 64px;
	}

	.logo {
		grid-area: logo;
		font-weight: 700;
		color: var(--color-text);
		text-decoration: none;
		white-space: nowrap;
	}

	.links {
		grid-area: links;
		display: flex;
		justify-content: flex-end;
		gap: 20px;
	}

	.links a {
		color: var(--color-muted);
		text-decoration: none;
		font-size: 15px;
		white-space: nowrap;
	}

	.links a:hover {
		color: var(--color-text);
	}

	.links a[aria-current='page'] {
		color: var(--color-accent);
		font-weight: 600;
	}

	.tools {
		grid-area: lang;
		display: flex;
		align-items: center;
		gap: 8px;
	}

	.theme {
		display: grid;
		place-items: center;
		width: 32px;
		height: 32px;
		padding: 0;
		border: 1px solid var(--color-border);
		border-radius: 50%;
		background: none;
		color: var(--color-muted);
		cursor: pointer;
	}

	.theme:hover {
		color: var(--color-text);
	}

	.theme svg,
	summary svg {
		width: 16px;
		height: 16px;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.8;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	/* Show the icon for the mode a click switches to. */
	.sun,
	:global(:root[data-theme='dark']) .moon {
		display: none;
	}

	:global(:root[data-theme='dark']) .sun {
		display: block;
	}

	@media (prefers-color-scheme: dark) {
		:global(:root:not([data-theme='light'])) .moon {
			display: none;
		}

		:global(:root:not([data-theme='light'])) .sun {
			display: block;
		}
	}

	.lang {
		position: relative;
		font-size: 13px;
	}

	summary {
		display: flex;
		align-items: center;
		gap: 6px;
		height: 32px;
		padding: 0 12px 0 10px;
		border: 1px solid var(--color-border);
		border-radius: 999px;
		color: var(--color-muted);
		white-space: nowrap;
		cursor: pointer;
		list-style: none;
	}

	summary::-webkit-details-marker {
		display: none;
	}

	summary::after {
		content: '';
		width: 6px;
		height: 6px;
		margin: -3px 0 0 2px;
		border-right: 1.5px solid currentColor;
		border-bottom: 1.5px solid currentColor;
		transform: rotate(45deg);
	}

	summary:hover,
	.lang[open] summary {
		color: var(--color-text);
	}

	.lang ul {
		position: absolute;
		top: calc(100% + 6px);
		right: 0;
		min-width: 120px;
		margin: 0;
		padding: 6px;
		border: 1px solid var(--color-border);
		border-radius: 10px;
		background: var(--color-bg);
		box-shadow: 0 8px 24px rgb(0 0 0 / 0.12);
		list-style: none;
	}

	.lang ul a {
		display: block;
		padding: 6px 10px;
		border-radius: 6px;
		color: var(--color-text);
		text-decoration: none;
	}

	.lang ul a:hover {
		background: var(--color-surface);
	}

	.lang ul a[aria-current] {
		color: var(--color-accent);
		font-weight: 600;
	}

	@media (max-width: 720px) {
		.inner {
			grid-template-columns: 1fr auto;
			grid-template-areas:
				'logo lang'
				'links links';
			height: auto;
			row-gap: 8px;
			padding-block: 12px 8px;
		}

		.links {
			justify-content: flex-start;
			overflow-x: auto;
			gap: 18px;
			scrollbar-width: none;
		}
	}
</style>
