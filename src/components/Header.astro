---
import { localizePath, pages, toLang, useTranslations } from '../i18n/ui';

const lang = toLang(Astro.currentLocale);
const t = useTranslations(lang);
const home = localizePath('/', lang);
const otherLang = lang === 'en' ? 'ko' : 'en';
const current = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;

const links = pages.map((page) => {
	const href = localizePath(`/${page}/`, lang);
	return { href, label: t(`nav.${page}`), active: current.startsWith(href) };
});
---

<header>
	<div class="container inner">
		<a class="logo" href={home}>{t('hero.name')}</a>
		<nav class="links">
			{
				links.map((link) => (
					<a href={link.href} aria-current={link.active ? 'page' : undefined}>
						{link.label}
					</a>
				))
			}
		</nav>
		<a class="lang" href={localizePath(Astro.url.pathname, otherLang)} hreflang={otherLang} lang={otherLang}>
			{t('lang.switch')}
		</a>
	</div>
</header>

<style>
	header {
		position: sticky;
		top: 0;
		z-index: 10;
		background: color-mix(in srgb, var(--color-bg) 88%, transparent);
		backdrop-filter: blur(8px);
		border-bottom: 1px solid var(--color-border);
		view-transition-name: site-header;
	}

	.inner {
		display: grid;
		grid-template-columns: auto 1fr auto;
		grid-template-areas: 'logo links lang';
		align-items: center;
		gap: 20px;
		height: 64px;
	}

	.logo {
		grid-area: logo;
		font-weight: 700;
		color: var(--color-text);
		text-decoration: none;
		white-space: nowrap;
	}

	.links {
		grid-area: links;
		display: flex;
		justify-content: flex-end;
		gap: 20px;
	}

	.links a,
	.lang {
		color: var(--color-muted);
		text-decoration: none;
		font-size: 15px;
		white-space: nowrap;
	}

	.links a:hover,
	.lang:hover {
		color: var(--color-text);
	}

	.links a[aria-current='page'] {
		color: var(--color-accent);
		font-weight: 600;
	}

	.lang {
		grid-area: lang;
		padding: 4px 10px;
		border: 1px solid var(--color-border);
		border-radius: 999px;
		font-size: 13px;
	}

	@media (max-width: 720px) {
		.inner {
			grid-template-columns: 1fr auto;
			grid-template-areas:
				'logo lang'
				'links links';
			height: auto;
			row-gap: 8px;
			padding-block: 12px 8px;
		}

		.links {
			justify-content: flex-start;
			overflow-x: auto;
			gap: 18px;
			scrollbar-width: none;
		}
	}
</style>
