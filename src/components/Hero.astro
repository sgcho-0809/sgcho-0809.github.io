---
import { profile } from '../data/profile';
import { localizePath, toLang, useTranslations } from '../i18n/ui';

const lang = toLang(Astro.currentLocale);
const t = useTranslations(lang);
---

<section class="hero">
	<div class="container">
		<p class="affiliation">{t('hero.affiliation')}</p>
		<h1>{t('hero.identity')}</h1>
		<p class="intro">{t('hero.intro')}</p>
		<div class="actions">
			<a class="button primary" href={localizePath('/projects/', lang)}>{t('hero.cta.projects')}</a>
			<a class="button" href={`mailto:${profile.email}`}>{t('hero.cta.contact')}</a>
		</div>
	</div>
</section>

<style>
	.hero {
		padding: 24px 0 56px;
	}

	.affiliation {
		display: inline-block;
		margin: 0 0 18px;
		padding-left: 12px;
		border-left: 3px solid var(--color-teal);
		color: var(--color-muted);
		font-size: 15px;
		font-weight: 500;
	}

	h1 {
		margin: 0 0 18px;
		font-size: clamp(30px, 4.6vw, 46px);
		font-weight: 700;
		letter-spacing: -0.02em;
		line-height: 1.2;
	}

	.intro {
		max-width: 640px;
		margin: 0;
		color: var(--color-muted);
		font-size: 17px;
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
		margin-top: 36px;
	}

	.button {
		padding: 10px 18px;
		border-radius: 8px;
		border: 1px solid var(--color-border);
		color: var(--color-text);
		font-size: 15px;
		font-weight: 500;
		text-decoration: none;
	}

	.button:hover {
		border-color: var(--color-muted);
	}

	.button.primary {
		background: var(--color-accent);
		border-color: var(--color-accent);
		color: var(--color-bg);
	}
</style>
