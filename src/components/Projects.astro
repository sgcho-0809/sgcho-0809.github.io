---
const projects = [
	{
		title: '프로젝트 1',
		description: '프로젝트에 대한 간단한 설명을 작성하세요.',
		tags: ['Tag A', 'Tag B'],
		link: '#',
	},
	{
		title: '프로젝트 2',
		description: '프로젝트에 대한 간단한 설명을 작성하세요.',
		tags: ['Tag A', 'Tag C'],
		link: '#',
	},
	{
		title: '프로젝트 3',
		description: '프로젝트에 대한 간단한 설명을 작성하세요.',
		tags: ['Tag B'],
		link: '#',
	},
];
---

<section id="projects">
	<div class="container">
		<h2 class="section-title">Projects</h2>
		<div class="grid">
			{
				projects.map((project) => (
					<a class="card" href={project.link}>
						<h3>{project.title}</h3>
						<p>{project.description}</p>
						<ul class="tags">
							{project.tags.map((tag) => <li>{tag}</li>)}
						</ul>
					</a>
				))
			}
		</div>
	</div>
</section>

<style>
	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
		gap: 16px;
	}

	.card {
		display: block;
		padding: 20px;
		border: 1px solid var(--color-border);
		border-radius: 14px;
		background: var(--color-surface);
		color: var(--color-text);
		text-decoration: none;
		transition: transform 0.2s;
	}

	.card:hover {
		transform: translateY(-2px);
	}

	h3 {
		margin: 0 0 8px;
		font-size: 18px;
	}

	p {
		margin: 0 0 16px;
		color: var(--color-muted);
		font-size: 15px;
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.tags li {
		font-size: 12px;
		color: var(--color-accent);
	}
</style>
